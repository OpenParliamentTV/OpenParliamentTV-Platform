########################################
# URL Rewrite Rules
########################################
<IfModule mod_rewrite.c>
	Options +FollowSymLinks
	RewriteEngine Off
	RewriteEngine On

	########################################
	# Block AI / scraper crawlers that ignore robots.txt (return 403) from the
	# HTML pages. Search engines (Googlebot, Bingbot, Applebot, …) and agents
	# fetching on a user's behalf (ChatGPT-User, Claude-User, …) are unaffected.
	# Exempt, so these crawlers can find and use the machine path:
	# robots.txt, llms.txt (and the .php generators the rewrites below hand
	# them to, since the rewritten request passes this rule again) and
	# everything under /api — the docs page, the OpenAPI spec and /api/v1/.
	# Keep this list in sync with $blockedBots in robots.php.
	########################################
	RewriteCond %{HTTP_USER_AGENT} (GPTBot|OAI-SearchBot|ClaudeBot|anthropic-ai|Claude-Web|Google-Extended|Applebot-Extended|PerplexityBot|CCBot|cohere-ai|Bytespider|Amazonbot|Meta-ExternalAgent|FacebookBot|Diffbot|ImagesiftBot|Omgilibot|YouBot|DataForSeoBot|PetalBot) [NC]
	RewriteRule !^(robots\.(txt|php)|llms\.(txt|php)|api(/.*)?)$ - [F,L]

	########################################
	# The entity dump moved into the API. Permanent redirect because external
	# NEL pipelines have this URL in their parliament manifests; the query
	# string carries the selection (?type=…&wiki=…) and is preserved.
	# Must precede the trailing-slash rule so the common form with the slash
	# lands on the API in one hop.
	########################################
	# %1 is the URI prefix the app is mounted under ("" at the docroot), taken
	# from REQUEST_URI so the target stays absolute without a RewriteBase.
	RewriteCond %{REQUEST_URI} ^(.*)/data/entity-dump/?$
	RewriteRule ^data/entity-dump/?$ %1/api/v1/entityDump [QSA,R=301,L]

	########################################
	# Always remove trailing slash (except for real directories)
	########################################
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteCond %{REQUEST_URI} (.+)/$
	RewriteRule ^ %1 [L,R=301]

	########################################
	# Sitemap, Robots & llms.txt (pretty URLs → PHP generators)
	########################################
	RewriteRule ^sitemap\.xml$ sitemap.php [L]
	RewriteRule ^robots\.txt$ robots.php [L]
	RewriteRule ^llms\.txt$ llms.php [L]

	########################################
	# Send all non-file, non-directory requests to index.php.
	# Existing files (JS, CSS, images, player.php, share-image.php,
	# api/…, etc.) are served directly by Apache and never hit the router.
	########################################
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^ index.php [QSA,L]
</IfModule>

########################################
# Add Mime Types
########################################
AddType video/mp4 .mp4
AddType video/x-m4v .m4v
AddType text/vtt .vtt
