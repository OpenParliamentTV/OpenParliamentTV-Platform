########################################
# Runtime state — never served directly.
#
# Caches, logs, import working files and cloned data repositories live here.
# The image caches under var/cache/ are streamed by their proxy endpoints
# (content/client/images/entity-image.php, meta-image.php), which read from
# disk and set their own headers — no direct URL access is required.
########################################

# Apache 2.4
<IfModule mod_authz_core.c>
	Require all denied
</IfModule>

# Apache 2.2
<IfModule !mod_authz_core.c>
	Order allow,deny
	Deny from all
</IfModule>
